          "name": "Web of Science Expanded Search Documents via GET",
          "request": {
            "name": "Web of Science Expanded Search Documents via GET",
            "description": {
              "content": "Submit search queries to retrieve Web of Science document metadata. Supports the Web of Science Advanced Search Query syntax with field tags, boolean operators, and wildcard characters. Returns a query ID and initial results page for subsequent pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "databaseId",
                  "value": "WOS",
                  "description": "(Required) Database to search (e.g., WOS for Web of Science Core Collection)."
                },
                {
                  "disabled": false,
                  "key": "usrQuery",
                  "value": "<string>",
                  "description": "(Required) Advanced search query string using Web of Science query syntax. Field tags include TS (topic), AU (author), TI (title), SO (source), DO (DOI), OG (organization), etc."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "10",
                  "description": "Number of records to return (1-100)."
                },
                {
                  "disabled": false,
                  "key": "firstRecord",
                  "value": "1",
                  "description": "Starting record number for pagination."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "Language of the results (default en)."
                },
                {
                  "disabled": false,
                  "key": "editions",
                  "value": "<string>",
                  "description": "Comma-separated list of WOS database editions to search."
                },
                {
                  "disabled": false,
                  "key": "publishTimeSpan",
                  "value": "<string>",
                  "description": "Publication date range filter in format begin=YYYY-MM-DD&end=YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "sortField",
                  "value": "<string>",
                  "description": "Field and direction for sorting results."
                },
                {
                  "disabled": false,
                  "key": "loadRecord",
                  "value": "<string>",
                  "description": "Include full record in response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
