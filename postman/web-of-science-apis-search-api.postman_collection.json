                  "value": "WOS"
                },
                {
                  "description": "(Required) Advanced search query string using Web of Science query syntax. Field tags include TS (topic), AU (author), TI (title), SO (source), DO (DOI), OG (organization), etc.",
                  "key": "usrQuery",
                  "value": "<string>"
                },
                {
                  "description": "Number of records to return (1-100).",
                  "key": "count",
                  "value": "10"
                },
                {
                  "description": "Starting record number for pagination.",
                  "key": "firstRecord",
                  "value": "1"
                },
                {
                  "description": "Language of the results (default en).",
                  "key": "lang",
                  "value": "en"
                },
                {
                  "description": "Comma-separated list of WOS database editions to search.",
                  "key": "editions",
                  "value": "<string>"
